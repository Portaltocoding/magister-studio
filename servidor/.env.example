# Copia este fichero a servidor/.env y cambia lo que difiera en tu máquina.
# Todo tiene un valor por defecto en src/magister/config.py.

# cli = claude -p (tu suscripción); eco = motor falso para probar sin cuota
MAGISTER_MOTOR=cli
# Modelo que usa claude -p (sonnet, opus, haiku)
MAGISTER_MODELO=sonnet
# Plazo máximo de una llamada al modelo, en segundos
MAGISTER_TIMEOUT_S=180
# Token local: si tiene valor, la API lo exige en X-Magister-Token (lo pone el proxy)
MAGISTER_TOKEN=
# Base principal, de pruebas (los tests) y de simulación (órdenes con --simulado)
MAGISTER_DB_URL=postgresql+asyncpg://magister:magister@127.0.0.1:5433/magister
MAGISTER_DB_URL_PRUEBAS=postgresql+asyncpg://magister:magister@127.0.0.1:5433/magister_pruebas
MAGISTER_DB_URL_SIM=postgresql+asyncpg://magister:magister@127.0.0.1:5433/magister_sim
