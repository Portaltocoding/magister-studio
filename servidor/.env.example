# Copia este fichero a servidor/.env y cambia lo que difiera en tu máquina.
# Todo tiene un valor por defecto en src/magister/config.py.

# cli = claude -p (tu suscripción); eco = motor falso para probar sin cuota
MAGISTER_MOTOR=cli
# Modelo que usa claude -p (sonnet, opus, haiku)
MAGISTER_MODELO=sonnet
# Plazo máximo de una llamada al modelo, en segundos
MAGISTER_TIMEOUT_S=180
# Token local: si tiene valor, la API lo exige en X-Magister-Token (lo pone el proxy)
MAGISTER_TOKEN=
# Base principal, de pruebas (los tests) y de simulación (órdenes con --simulado)
MAGISTER_DB_URL=postgresql+asyncpg://magister:magister@127.0.0.1:5433/magister
MAGISTER_DB_URL_PRUEBAS=postgresql+asyncpg://magister:magister@127.0.0.1:5433/magister_pruebas
MAGISTER_DB_URL_SIM=postgresql+asyncpg://magister:magister@127.0.0.1:5433/magister_sim

# Plan (Parte II)
MAGISTER_REINTENTOS=2
MAGISTER_HOLGURA=0.15
MAGISTER_HORAS_MAX_LECCION=4
MAGISTER_PARTIR_LECCIONES=true

# Fuentes y RAG (Parte III). La primera vez se descargan e5-small y el reranker (unos 600 MB).
MAGISTER_EMBEDDINGS=local
MAGISTER_EMBEDDINGS_MODELO=intfloat/multilingual-e5-small
MAGISTER_RERANKER_MODELO=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
MAGISTER_CONFIG_INDICE=v1
MAGISTER_VALIDEZ_MIN=0.85
MAGISTER_PAGINAS_MIN=0.9
MAGISTER_UMBRAL_FUENTES=0.85
MAGISTER_UMBRAL_APOYO=0.85
MAGISTER_PROCESAR_FONDO=true

# Research (Parte III)
MAGISTER_RESEARCH_PASOS=12
MAGISTER_RESEARCH_LLAMADAS=8
MAGISTER_RESEARCH_PROPUESTAS=5
MAGISTER_RESEARCH_SEGUNDOS=180

# Material (Parte IV): salidas en la raíz del repo; pandoc, Chrome y pdftotext para el PDF; Marp con npx
MAGISTER_PANDOC=C:/Users/<tu usuario>/AppData/Local/Pandoc
MAGISTER_TRABAJOS_EN_API=true
MAGISTER_TRABAJOS_LEASE_S=120
MAGISTER_TRABAJOS_INTENTOS=5
# Trabajos de la cola a la vez por trabajador (nunca dos de la misma lección; los largos dejan un hueco)
MAGISTER_TRABAJOS_A_LA_VEZ=2
MAGISTER_DURACION_GUION_MIN=8

# Aprender (Parte V)
MAGISTER_PROGRAMADOR=fsrs
MAGISTER_RETENCION=0.9
MAGISTER_INICIO_DIA=04:00
MAGISTER_ZONA=Europe/Madrid
MAGISTER_NUEVOS_DIA=10
MAGISTER_SIMULADO=false

# Producción (Parte VI)
MAGISTER_PLAZO_PRIMER_TOKEN_S=60
MAGISTER_JUEZ_MUESTRA=0.5
MAGISTER_SERVIR_WEB=true
# MAGISTER_CANARIO se genera solo al arrancar la primera vez (tabla instalacion)
# Un modelo por tarea, por encima de config/modelos.yaml: MAGISTER_MODELO_EXTRAER=cli:haiku
# Langfuse (opcional): LANGFUSE_PUBLIC_KEY, LANGFUSE_SECRET_KEY, LANGFUSE_HOST
