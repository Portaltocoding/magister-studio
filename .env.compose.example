# Copia a .env.compose (fuera de git); los arrancadores (Magister.command, magister.sh, Magister-docker.bat) lo hacen
# solos la primera vez. Los secretos van en secretos/ (claude_token, postgres_password, canario), nunca aquí.
# Las rutas de dentro del contenedor (datos, copias, Piper, Chromium) ya vienen en servidor/Dockerfile.
MAGISTER_MOTOR=cli
MAGISTER_MODELO=sonnet
MAGISTER_DIR_SECRETOS=/run/secrets
MAGISTER_TRABAJOS_EN_API=true
MAGISTER_PROGRAMADOR=fsrs
# La copia del día de la base, dentro de la API (rotación 7 diarias, 4 semanales y 12 mensuales en el volumen de copias)
MAGISTER_COPIA_DIARIA=true
