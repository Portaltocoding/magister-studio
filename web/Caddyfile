# Caddy dentro de Docker: /api/* a la API, lo demás ficheros estáticos con vuelta a index.html.
# Las respuestas de /api llevan la CSP que pone la API (las diapositivas se ven en un iframe con su script): Caddy no
# la pisa. La página lleva la misma que la API le pone cuando la sirve ella (http://localhost:8000).
:80 {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	handle /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}
	handle {
		header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' blob: data:; frame-ancestors 'none'"
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
