# Lo que se ejecuta en Mac, Linux o dentro de Docker va siempre con LF (con CRLF, sh falla en la primera línea),
# también al clonar en Windows con core.autocrlf=true. Los .bat, con CRLF.
*.sh       text eol=lf
*.command  text eol=lf
servidor/Dockerfile  text eol=lf
web/Dockerfile       text eol=lf
web/Caddyfile        text eol=lf
*.bat      text eol=crlf
# El LEEME del paquete de Windows, con CRLF para el Bloc de notas antiguo.
distribucion/LEEME-Windows.txt  text eol=crlf
# Los paquetes sin Docker: el de Windows (.ps1 con BOM para PowerShell 5, y su LEEME) con CRLF.
distribucion/nativo/*.ps1  text eol=crlf
distribucion/nativo/*-nativo.bat text eol=crlf
distribucion/nativo/LEEME-Windows-nativo.txt text eol=crlf
